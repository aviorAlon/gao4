# 复制这个文件为 .env.local（同目录），把下面的占位符换成真实 key。
# .env.local 已经在 .gitignore 里（.env.* 那一条），不会被提交，放心填真实密钥。
# 只需要填你要启用的角色；某个角色的 API_KEY 留空/不写这一行，那个角色就还是关闭状态。

EXAM_DIAGNOSIS_ANALYSIS_API_KEY=sk-your-deepseek-key-here
EXAM_DIAGNOSIS_REPORT_API_KEY=sk-your-deepseek-key-here
EXAM_DIAGNOSIS_VERIFY_API_KEY=sk-your-deepseek-key-here
EXAM_DIAGNOSIS_GRADE_API_KEY=sk-your-deepseek-key-here
# EXAM_DIAGNOSIS_SPLIT_API_KEY=sk-your-deepseek-key-here
# EXAM_DIAGNOSIS_MATCH_API_KEY=sk-your-deepseek-key-here   # 题目→知识点语义匹配（默认 deepseek-v4-flash）

# 不填 BASE_URL / MODEL 时用 DeepSeek 默认值；换其它 OpenAI-compatible 服务商就取消注释覆盖：
# EXAM_DIAGNOSIS_ANALYSIS_BASE_URL=https://api.deepseek.com
# EXAM_DIAGNOSIS_ANALYSIS_MODEL=deepseek-v4-pro

# 图片 / 扫描版 PDF 的视觉解析：需要一个真正支持图片输入的模型（DeepSeek 对话模型不接受图片，
# 比如通义千问 Qwen-VL 的 OpenAI-compatible 接口可以）。三项都填才会启用。
# EXAM_DIAGNOSIS_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EXAM_DIAGNOSIS_VISION_API_KEY=sk-your-vision-key-here
# EXAM_DIAGNOSIS_VISION_MODEL=qwen-vl-max
# EXAM_DIAGNOSIS_VISION_TIMEOUT=60
# EXAM_DIAGNOSIS_SCANNED_PDF_MAX_PAGES=30

# 成本控制（默认不限制）
# EXAM_DIAGNOSIS_MODEL_DAILY_TOKEN_BUDGET=200000
# EXAM_DIAGNOSIS_MODEL_MAX_CALLS_PER_MINUTE=20

# 后台任务工作线程数（默认 1）
# EXAM_DIAGNOSIS_TASK_WORKERS=1

# 登录：默认不强制（本地单人零配置）；设为 1 后除注册/登录外所有接口都必须带 token
# EXAM_DIAGNOSIS_AUTH_REQUIRED=0
# EXAM_DIAGNOSIS_SESSION_TTL_HOURS=720
