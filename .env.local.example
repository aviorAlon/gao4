# Copy this file to .env.local (same directory) and replace the placeholders with real keys.
# .env.local is covered by .gitignore (the `.env.*` rule) and is never committed.
# Only fill in the roles you want to enable: a role whose API_KEY is empty/absent stays off and
# the application uses its deterministic fallback for that step.
#
# 复制为同目录下的 .env.local，把占位符换成真实 key。.env.local 已被 .gitignore 忽略，不会提交。
# 只需要填你要启用的角色；某个角色的 API_KEY 留空/不写，那个角色就还是关闭状态，走本地兜底逻辑。

# --- Model roles / 模型角色 -----------------------------------------------------------------------
# NOTE: no inline comments after a value — the loader takes everything after '=' literally.
# 注意：值后面不要写行内注释，加载器会把 '=' 后面的内容整个当成值。
# analysis = root-cause diagnosis / 错因诊断（推理档）
EXAM_DIAGNOSIS_ANALYSIS_API_KEY=sk-your-key-here
# verify = variant practice questions / 验证题生成（推理档）
EXAM_DIAGNOSIS_VERIFY_API_KEY=sk-your-key-here
# grade = grading submitted answers / 验证题批改（推理档）
EXAM_DIAGNOSIS_GRADE_API_KEY=sk-your-key-here
# report = report narrative / 报告概述（快速档）
EXAM_DIAGNOSIS_REPORT_API_KEY=sk-your-key-here
# split = question splitting / 题目切分（快速档）
# EXAM_DIAGNOSIS_SPLIT_API_KEY=sk-your-key-here
# match = question → knowledge point / 知识点语义匹配（快速档）
# EXAM_DIAGNOSIS_MATCH_API_KEY=sk-your-key-here

# --- Default provider / 默认服务商 ----------------------------------------------------------------
# Every role talks to one OpenAI-compatible endpoint. Point all of them at your provider here
# (leave unset to use the built-in profile printed by GET /api/system/status). Any provider that
# speaks the OpenAI chat-completions API works.
# 所有角色都走 OpenAI-compatible 接口。在这里一次性指定服务商和两档模型（不设则用内置默认值，
# GET /api/system/status 会打出来）。任何兼容 OpenAI chat-completions 的服务都可以。
# EXAM_DIAGNOSIS_DEFAULT_BASE_URL=https://api.your-provider.com/v1
# reasoning tier: analysis / verify / grade; fast tier: split / report / match
# EXAM_DIAGNOSIS_DEFAULT_REASONING_MODEL=your-reasoning-model
# EXAM_DIAGNOSIS_DEFAULT_FAST_MODEL=your-fast-model

# Per-role overrides beat the provider-wide defaults / 单个角色的覆盖优先于上面的默认值：
# EXAM_DIAGNOSIS_ANALYSIS_BASE_URL=https://api.other-provider.com/v1
# EXAM_DIAGNOSIS_ANALYSIS_MODEL=some-other-model
# EXAM_DIAGNOSIS_ANALYSIS_TIMEOUT=30

# --- Vision (images / scanned PDFs) / 视觉解析（图片、扫描版 PDF） -------------------------------
# Needs a model that genuinely accepts image input; all three values are required to enable it.
# 需要一个真正支持图片输入的模型；三项都填才会启用。
# EXAM_DIAGNOSIS_VISION_BASE_URL=https://api.your-vision-provider.com/v1
# EXAM_DIAGNOSIS_VISION_API_KEY=sk-your-vision-key-here
# EXAM_DIAGNOSIS_VISION_MODEL=your-vision-model
# EXAM_DIAGNOSIS_VISION_TIMEOUT=60
# EXAM_DIAGNOSIS_SCANNED_PDF_MAX_PAGES=30

# --- Cost control (unlimited by default) / 成本控制（默认不限制） ---------------------------------
# EXAM_DIAGNOSIS_MODEL_DAILY_TOKEN_BUDGET=200000
# EXAM_DIAGNOSIS_MODEL_MAX_CALLS_PER_MINUTE=20

# --- Background task workers (default 1) / 后台任务工作线程数（默认 1） ---------------------------
# EXAM_DIAGNOSIS_TASK_WORKERS=1

# --- Login / 登录 --------------------------------------------------------------------------------
# Off by default (single local user, zero config). Set to 1 to require a token on every request
# except register/login. / 默认不强制；设为 1 后除注册/登录外所有接口都必须带 token。
# EXAM_DIAGNOSIS_AUTH_REQUIRED=0
# EXAM_DIAGNOSIS_SESSION_TTL_HOURS=720

# --- Data location / 数据位置 --------------------------------------------------------------------
# EXAM_DIAGNOSIS_DATA_DIR=./data
