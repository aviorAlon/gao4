# 复制这个文件为 .env.local（同目录），把下面的占位符换成真实 key。
# .env.local 已经在 .gitignore 里（.env.* 那一条），不会被提交，放心填真实密钥。
# 只需要填你要启用的角色；某个角色的 API_KEY 留空/不写这一行，那个角色就还是关闭状态。

EXAM_DIAGNOSIS_ANALYSIS_API_KEY=sk-your-deepseek-key-here
EXAM_DIAGNOSIS_REPORT_API_KEY=sk-your-deepseek-key-here
EXAM_DIAGNOSIS_VERIFY_API_KEY=sk-your-deepseek-key-here
# EXAM_DIAGNOSIS_SPLIT_API_KEY=sk-your-deepseek-key-here

# 不填 BASE_URL / MODEL 时用 DeepSeek 默认值；换其它 OpenAI-compatible 服务商就取消注释覆盖：
# EXAM_DIAGNOSIS_ANALYSIS_BASE_URL=https://api.deepseek.com
# EXAM_DIAGNOSIS_ANALYSIS_MODEL=deepseek-v4-pro
